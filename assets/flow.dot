digraph G {
  graph [rankdir=TB, fontname="Noto Sans CJK TC", fontsize=30, labelloc=t, label="Picasso 的錢去了哪裡（Ethereum 鏈上，USDC/USDT，金額為 Picasso 的份額，USD）\n2025-08 ～ 2025-11 ・ 查詢日 2026-10-04", nodesep=0.35, ranksep=0.7, pad=0.4, dpi=110];
