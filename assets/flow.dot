  x2   [label="X2 歸集樞紐 0xfEF2a9E0…\n(2025-10-16 被 Tether 凍結)", fillcolor="#e0e0e0"];
  x34  [label="X3 0xDe8d7BdD… / X4 0x97915F7d…\n(X4 2025-10-16 被 Tether 凍結)", fillcolor="#e0e0e0"];
